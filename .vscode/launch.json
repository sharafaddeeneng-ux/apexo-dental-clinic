
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "apexo-flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "Apexo - Windows",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "windows"
        },
        {
            "name": "apexo-flutter (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "apexo-flutter (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "apexo-flutter (web, COOP/COEP)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--web-header=Cross-Origin-Opener-Policy=same-origin",
                "--web-header=Cross-Origin-Embedder-Policy=require-corp"
            ]
        }
    ]
}
